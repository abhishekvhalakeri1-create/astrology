# Optional settings, read when the site is built (npm run build).
# Copy this file to .env.production and remove the "#" in front of the lines you need.

# The folder the site is served from, if it is not the root of its domain.
# For https://name.github.io/astrology/ this is /astrology
#NEXT_PUBLIC_BASE_PATH=/astrology

# The public address of the site, without a trailing slash. Used for the sitemap
# and for the picture that appears when a link to the site is shared.
#NEXT_PUBLIC_SITE_URL=https://www.example.com
