# App
NEXT_PUBLIC_APP_NAME=AstroConnect
NEXT_PUBLIC_APP_TAGLINE=Guidance Written in the Stars
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LOW_DATA_MODE=false

# Auth
JWT_SECRET=super_secret_jwt_key_change_in_prod_32chars
JWT_REFRESH_SECRET=refresh_secret_key_change_in_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database - PostgreSQL (prod) / SQLite fallback for low-end
DATABASE_URL=postgresql://postgres:password@localhost:5432/astroconnect
# For low-end / demo: sqlite://./dev.db

# Payments - Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Real-time - Socket.IO
SOCKET_IO_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Calls - WebRTC (Daily.co / Agora / Twilio)
NEXT_PUBLIC_WEBRTC_PROVIDER=webrtc
DAILY_API_KEY=xxx
AGORA_APP_ID=xxx
AGORA_APP_CERTIFICATE=xxx

# Storage - S3 / Cloudinary
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=astroconnect-uploads
AWS_REGION=ap-south-1
CLOUDINARY_URL=cloudinary://xxx

# Notifications - Firebase
FCM_SERVER_KEY=xxx
NEXT_PUBLIC_FIREBASE_API_KEY=xxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxx
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxx

# Admin
ADMIN_EMAIL=admin@astroconnect.com
ADMIN_PASSWORD_HASH=$2a$10$xxx

# Features
ENABLE_AI_CHAT=true
ENABLE_WALLET=true
ENABLE_VIDEO_CALL=true
ENABLE_MULTI_LANGUAGE=true
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,kn

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000
